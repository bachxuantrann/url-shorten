# =============================================
#  .env.dev
#  Biến môi trường cho môi trường DEV local.
#  Dùng kèm docker-compose.dev.yml (cho infra)
#  và có thể load vào IDE khi chạy Spring Boot.
#
#  File này KHÔNG chứa secret thật — an toàn để commit.
# =============================================

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener_db
DB_USERNAME=auradev
DB_PASSWORD=auradev123

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Cluster ID cố định cho dev (không cần đổi)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ===== JWT =====
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=604800000
JWT_ISSUER=url-shortener-dev

# ===== Server =====
SERVER_PORT=8080

# ===== Admin Account (DataInitializer) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_EMAIL=admin@auradev.local
ADMIN_FULL_NAME=System Admin
