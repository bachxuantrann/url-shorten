# =============================================
#  .env.dev
#  Biến môi trường cho môi trường DEV local.
#  Dùng kèm docker-compose.dev.yml (cho infra)
#  và có thể load vào IDE khi chạy Spring Boot.
#
#  File này KHÔNG chứa secret thật — an toàn để commit.
# =============================================

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener_db
DB_USERNAME=auradev
DB_PASSWORD=auradev123

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Cluster ID cố định cho dev (không cần đổi)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ===== JWT =====
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=604800000
JWT_ISSUER=url-shortener-dev

# ===== Shortener =====
# Domain công khai của short link (không có dấu / ở cuối)
APP_BASE_URL=http://localhost:8080
# Khoá xáo trộn short code — chỉ dùng cho dev, KHÔNG dùng lại ở prod
SHORT_CODE_SECRET=3b8a535abb7ec29b3b49383e0e6d22e64b74555ce6263071e7ce5c39bb4ead8e

# Khoá băm danh tính khách truy cập (đếm unique visitor) — chỉ dùng cho dev
CLICK_VISITOR_SECRET=dev-only-visitor-secret-change-me

# File MaxMind GeoLite2-Country (tải từ tài khoản MaxMind, KHÔNG commit). Đường dẫn tính từ thư mục url-shortener/.
# Đặt biến này mà file không tồn tại thì app không khởi động; xoá dòng này nếu máy bạn chưa có file.
GEOIP_DATABASE=C:/Users/ADMIN/Desktop/Url Shorter/url-shorten/url-shortener/geoip/GeoLite2-Country.mmdb

# ===== Server =====
SERVER_PORT=8080

# ===== Admin Account (DataInitializer) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_EMAIL=admin@auradev.local
ADMIN_FULL_NAME=System Admin

# ===== Observability: gửi trace/metric/log tới OpenObserve của docker-compose.dev.yml (giao diện http://localhost:5080) =====
# Chưa bật OpenObserve thì đặt OTEL_EXPORT_ENABLED=false để khỏi có cảnh báo không kết nối được.
OTEL_EXPORT_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
# Tài khoản root chỉ dành cho dev cục bộ (docker-compose.dev.yml dùng cùng giá trị làm mặc định)
OPENOBSERVE_EMAIL=dev@example.com
OPENOBSERVE_PASSWORD=DevOnly#12345
# Header Authorization = "Basic " + base64(OPENOBSERVE_EMAIL:OPENOBSERVE_PASSWORD). Đổi mật khẩu thì phải tính lại.
OTEL_EXPORTER_OTLP_AUTHORIZATION=Basic ZGV2QGV4YW1wbGUuY29tOkRldk9ubHkjMTIzNDU=
