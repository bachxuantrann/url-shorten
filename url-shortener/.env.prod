# =============================================
#  .env.prod
#  Biến môi trường cho môi trường PRODUCTION.
#  Dùng kèm docker-compose.prod.yml.
#
#  !! KHÔNG commit file này lên git !!
#  Xem .env.prod.example để biết cấu trúc.
# =============================================

# ===== PostgreSQL =====
DB_NAME=url_shortener_prod
DB_USERNAME=auradev_prod
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ===== Kafka (KRaft) =====
# Tạo Cluster ID: docker run --rm confluentinc/cp-kafka:7.6.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=CHANGE_ME_BASE64_UUID
KAFKA_LOG_RETENTION_HOURS=168

# ===== JWT =====
# Tạo secret 64-byte hex: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET_AT_LEAST_512_BITS
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=604800000
JWT_ISSUER=url-shortener-prod

# ===== Server =====
SERVER_PORT=8080

# ===== Admin Account (DataInitializer) =====
# Mật khẩu raw — sẽ được BCrypt encode trong code khi khởi động lần đầu
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_FULL_NAME=System Admin

# ===== Shortener =====
# Domain công khai của short link (không có dấu / ở cuối)
APP_BASE_URL=https://CHANGE_ME_YOUR_DOMAIN
# Khoá xáo trộn short code — phải CỐ ĐỊNH qua các lần deploy. Tạo bằng: openssl rand -hex 32
SHORT_CODE_SECRET=3b8a535abb7ec29b3b49383e0e6d22e64b74555ce6263071e7ce5c39bb4ead8e
# Khoá HMAC băm IP+User-Agent thành visitor id (không lưu IP thô). Đổi khoá chỉ làm đếm unique visitor
# đứt quãng một lần. Tạo bằng: openssl rand -hex 32
CLICK_VISITOR_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Đường dẫn TRONG container tới file MaxMind GeoLite2-Country.mmdb (mount vào). Để trống = không ghi quốc gia.
GEOIP_DATABASE=

# ===== Observability (OTLP -> OpenObserve), xem docs/observability.md =====
OTEL_EXPORT_ENABLED=false
# Gốc OTLP/HTTP của backend (app thêm /v1/traces, /v1/metrics, /v1/logs). Trong container, localhost là chính container.
# Dùng service openobserve của docker-compose.prod.yml (profile observability): http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
# Tài khoản root của OpenObserve (chỉ cần khi chạy profile observability). ĐỔI sang giá trị mạnh.
OPENOBSERVE_EMAIL=CHANGE_ME_OBSERVABILITY_EMAIL
OPENOBSERVE_PASSWORD=CHANGE_ME_STRONG_OBSERVABILITY_PASSWORD
# "Basic " + base64(OPENOBSERVE_EMAIL:OPENOBSERVE_PASSWORD). Tạo bằng: printf 'email:password' | base64
OTEL_EXPORTER_OTLP_AUTHORIZATION=CHANGE_ME_BASIC_AUTH_HEADER
OTEL_SERVICE_NAME=url-shortener
TRACING_SAMPLING_PROBABILITY=0.1
# true = job đối soát tự sửa urls.click_count lệch (mặc định chỉ log cảnh báo)
CLICK_RECONCILE_REPAIR=false

# ===== Caddy (HTTPS + reverse proxy + UI + rate limit) =====
# Domain công khai (DNS phải đã trỏ về server): Caddy tự lấy chứng chỉ Let's Encrypt. APP_BASE_URL phải là https://<domain này>.
SITE_ADDRESS=CHANGE_ME_YOUR_DOMAIN
ACME_EMAIL=CHANGE_ME_ADMIN_EMAIL
# Cổng publish ra host (mặc định 80/443)
HTTP_PORT=80
HTTPS_PORT=443
# Ngưỡng rate limit của Caddy: số request/phút/IP của từng nhóm (lớp thô, trước lớp Redis trong app)
RATE_LIMIT_API_PER_MIN=240
RATE_LIMIT_AUTH_PER_MIN=15
RATE_LIMIT_UNLOCK_PER_MIN=30
RATE_LIMIT_ANON_CREATE_PER_MIN=20
RATE_LIMIT_REDIRECT_PER_MIN=600

# ===== Backup PostgreSQL =====
# Thư mục TRÊN HOST nhận bản dump: nên là đĩa/phân vùng khác đĩa chứa volume Postgres. Phải tồn tại và ghi được.
BACKUP_DIR=/var/backups/url-shortener
# Giờ chạy hằng ngày (UTC), số bản giữ lại
BACKUP_AT=03:15
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# ===== Image (tuỳ chọn): CI đẩy lên GHCR, server chỉ pull. Bỏ trống = build tại chỗ =====
# APP_IMAGE=ghcr.io/<owner>/<repo>/app:v1.0.0
# CADDY_IMAGE=ghcr.io/<owner>/<repo>/caddy:v1.0.0
