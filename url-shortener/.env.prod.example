# =============================================
#  .env.prod.example
#  Template cho file .env.prod (KHÔNG commit file thật lên git)
#  Copy file này, đổi tên thành .env.prod và điền giá trị thực.
# =============================================

# ===== PostgreSQL =====
DB_NAME=url_shortener_prod
DB_USERNAME=auradev_prod
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ===== JWT =====
# Tạo secret 64-byte hex: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET_AT_LEAST_512_BITS

# ===== Server =====
SERVER_PORT=8080
